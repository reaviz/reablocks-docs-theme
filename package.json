{
  "name": "reablocks-docs-theme",
  "version": "2.3.0",
  "description": "A Nextra theme for documentation reablocks site.",
  "repository": "https://github.com/reaviz/reablocks-docs-theme",
  "license": "MIT",
  "exports": {
    "./style.css": "./dist/style.css",
    "./style-prefixed.css": "./dist/style-prefixed.css",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "NODE_ENV=production tsup",
    "dev": "tsup --watch . --watch ../nextra/src --watch ../nextra/styles",
    "test": "vitest run",
    "types:check": "tsc --noEmit"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "peerDependencies": {
    "next": ">=14",
    "nextra": ">=4.6.0",
    "react": ">=19.1.0",
    "react-compiler-runtime": "^19.1.0-rc.2",
    "react-dom": ">=19.1.0"
  },
  "peerDependenciesMeta": {
    "react-compiler-runtime": {
      "optional": true
    }
  },
  "dependencies": {
    "@headlessui/react": "^2.1.2",
    "clsx": "^2.1.0",
    "next-themes": "^0.4.0",
    "reablocks": "^9.1.2",
    "react-syntax-highlighter": "^15.6.1",
    "scroll-into-view-if-needed": "^3.1.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.10",
    "@tailwindcss/postcss": "^4.1.10",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.14",
    "@types/react": "^19.0.12",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "^19.1.0-rc.2",
    "jsdom": "^26.0.0",
    "next": "^15.0.2",
    "nextra": "^4.6.1",
    "postcss": "^8.4.49",
    "react": "19.1.1",
    "react-compiler-webpack": "^1.0.1",
    "tailwindcss": "^4.1.10",
    "tsup": "^8.5.0",
    "vitest": "^3.0.0",
    "zx": "^8.2.4"
  },
  "sideEffects": false
}
